# Base URL of the FastAPI backend as seen by the browser.
# Leave empty in development: Vite proxies /api to VITE_DEV_BACKEND_URL.
# Set it for production builds served from a different origin, e.g.
# VITE_API_BASE_URL=https://api.example.com
VITE_API_BASE_URL=

# Backend address used by the Vite dev-server proxy.
VITE_DEV_BACKEND_URL=http://127.0.0.1:8000
